{
  "name": "hekademos-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "prisma generate && prisma migrate deploy && npm run prisma:seed:admin && next build",
    "build:deploy": "prisma generate && prisma migrate deploy && npm run prisma:seed:admin && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:seed:admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types prisma/seed-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@vercel/analytics": "^2.0.1",
    "formik": "^2.4.9",
    "gsap": "^3.14.2",
    "next": "16.1.6",
    "nodemailer": "^9.0.3",
    "prisma": "^6.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "react-toastify": "^11.1.0",
    "sass": "^1.97.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/gsap": "^1.20.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "typescript": "^5"
  }
}
