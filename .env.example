# Base de datos
DB_USER=hekademos
DB_PASSWORD=reemplazar-para-desarrollo-local
DB_NAME=hekademos
DATABASE_URL=postgresql://usuario:clave@servidor:5432/hekademos

# Aplicación y autenticación
NEXT_PUBLIC_APP_URL=https://tu-dominio.com
# AUTH_BASE_URL puede usarse como alternativa server-only a NEXT_PUBLIC_APP_URL.
AUTH_BASE_URL=
AUTH_SESSION_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Estas credenciales solo crean o actualizan el administrador real en PostgreSQL durante el deploy.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=reemplazar-por-una-clave-segura-de-al-menos-12-caracteres
# Para servidores propios. Vercel activa la validación mediante VERCEL_ENV.
HEKADEMOS_VALIDATE_PRODUCTION_ENV=true

# Email obligatorio: recuperación de contraseña y respaldo de notificaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notificaciones@tu-dominio.com
SMTP_PASS=reemplazar-por-la-clave-o-app-password
EMAIL_FROM_NAME=Hekademos
EMAIL_FROM_ADDRESS=notificaciones@tu-dominio.com
CONTACT_TO_EMAIL=contacto@tu-dominio.com
ADMIN_NOTIFICATION_EMAIL=admin@tu-dominio.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=reemplazar
CLOUDINARY_API_KEY=reemplazar
CLOUDINARY_API_SECRET=reemplazar
CLOUDINARY_UPLOAD_FOLDER=Hekademos

# Cobros
PAYMENT_REMINDER_DAY=1
# Activar solo en Production, después de aprobar la plantilla y aplicar migraciones.
PAYMENT_REMINDERS_ENABLED=false
CRON_SECRET=
WHATSAPP_PAYMENT_TEMPLATE_NAME=recordatorio_cuota
WHATSAPP_PAYMENT_TEMPLATE_LANGUAGE=es_AR
PAYMENT_LATE_WARNING_DAY=9
PAYMENT_DUE_DAY=10
PAYMENT_LATE_SURCHARGE_PERCENT=20

# WhatsApp Business. Si WHATSAPP_ENABLED=false, el resto no es obligatorio.
WHATSAPP_ENABLED=true
WHATSAPP_TEST_MODE=false
WHATSAPP_PRODUCTION_SENDS_CONFIRMED=true
ACCESS_TOKEN_WHATSAPP_BUSINESS=reemplazar-por-el-token-permanente
PHONE_NUMBER_ID=reemplazar-por-el-id-numerico
WHATSAPP_BUSINESS_ACCOUNT_ID=reemplazar-por-el-id-numerico
WHATSAPP_API_VERSION=v25.0
WHATSAPP_SCHEDULE_TEMPLATE_NAME=cambio_horario_confirmado
WHATSAPP_SCHEDULE_TEMPLATE_LANGUAGE=es_AR
WHATSAPP_TEST_RECIPIENT=
