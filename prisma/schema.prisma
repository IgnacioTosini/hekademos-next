generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

generator clientjs {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COACH
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ScheduleChangeRequestType {
  ONE_TIME
  PERMANENT
}

enum ScheduleChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String?
  phone          String?
  passwordHash   String?
  sessionVersion Int        @default(0)
  emailVerified  DateTime?
  role           Role       @default(STUDENT)
  status         UserStatus @default(ACTIVE)

  student Student?
  coach   Coach?
  image   UserImage?
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

model UserImage {
  id String @id @default(cuid())

  url      String
  publicId String

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  actorRole   Role?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model SiteContent {
  key             String   @id
  value           Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

model Student {
  id                    String    @id @default(cuid())
  userId                String    @unique
  coachId               String?
  firstName             String?
  lastName              String?
  birthDate             DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  routineExcelUrl       String?
  notes                 String?

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach       Coach?              @relation(fields: [coachId], references: [id], onDelete: SetNull)
  memberships StudentMembership[]
  payments    Payment[]
  paymentReminders PaymentReminderDelivery[]
  attendance  Attendance[]
  schedules   StudentScheduleAssignment[]
  scheduleChangeRequests ScheduleChangeRequest[]
  communityComments CommunityComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId])
}

model PaymentReminderDelivery {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  reminderType String
  status       String   @default("PROCESSING")
  channel      String?
  messageId    String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, periodStart, reminderType])
  @@index([periodStart, status])
}

model Coach {
  id                   String  @id @default(cuid())
  userId               String  @unique
  bio                  String?
  specialty            String?
  instagram            String?
  paymentAlias         String?
  paymentAccountHolder String?
  isActive             Boolean @default(true)

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  students        Student[]
  weeklySchedules WeeklyClassSchedule[]
  classSessions   ClassSession[]
  communityPosts  CommunityPost[]
  communityComments CommunityComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MembershipPlan {
  id                  String  @id @default(cuid())
  name                String  @unique
  classCategory       String  @default("Calistenia")
  trainingDaysPerWeek Int
  priceCents          Int
  currency            String  @default("ARS")
  isRecommended       Boolean @default(false)
  isActive            Boolean @default(true)

  memberships StudentMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentMembership {
  id                String           @id @default(cuid())
  studentId         String
  planId            String
  startDate         DateTime
  endDate           DateTime?
  status            MembershipStatus @default(ACTIVE)
  classesUsed       Int              @default(0)
  monthlyPriceCents Int?
  notes             String?

  student   Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan      MembershipPlan              @relation(fields: [planId], references: [id])
  payments  Payment[]
  schedules StudentScheduleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([planId])
}

model Payment {
  id                  String        @id @default(cuid())
  studentId           String
  studentMembershipId String?
  periodStart         DateTime
  amountCents         Int
  currency            String        @default("ARS")
  status              PaymentStatus @default(PENDING)
  dueDate             DateTime?
  paidAt              DateTime?
  reference           String?
  notes               String?

  student           Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentMembership StudentMembership? @relation(fields: [studentMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@unique([studentId, periodStart])
  @@index([studentMembershipId])
  @@index([paidAt])
}

model WeeklyClassSchedule {
  id              String    @id @default(cuid())
  dayOfWeek       DayOfWeek
  classCategory   String    @default("Calistenia")
  startTime       String
  durationMinutes Int       @default(90)
  capacity        Int?
  coachId         String?
  isActive        Boolean   @default(true)
  notes           String?

  coach              Coach?                      @relation(fields: [coachId], references: [id], onDelete: SetNull)
  sessions           ClassSession[]
  studentAssignments StudentScheduleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, startTime, coachId])
  @@index([classCategory])
  @@index([coachId])
  @@index([isActive])
}

model CommunityPost {
  id             String             @id @default(cuid())
  type           String
  title          String
  content        String
  videoUrl       String?
  isPublished    Boolean           @default(true)
  authorCoachId  String?
  createdByName  String?
  createdByEmail String?
  authorCoach    Coach?             @relation(fields: [authorCoachId], references: [id], onDelete: SetNull)
  comments       CommunityComment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([isPublished, createdAt])
  @@index([type])
  @@index([authorCoachId])
}

model CommunityComment {
  id              String        @id @default(cuid())
  postId          String
  studentId       String?
  coachId         String?
  authorRole      Role          @default(STUDENT)
  authorName      String?
  createdByUserId String?
  content         String
  post            CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  student         Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  coach           Coach?        @relation(fields: [coachId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([postId, createdAt])
  @@index([studentId])
  @@index([coachId])
  @@index([createdByUserId])
}

model ClassCategoryOption {
  id                String   @id @default(cuid())
  name              String
  normalizedName    String   @unique
  isSpecialActivity Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([name])
}

model StudentScheduleAssignment {
  id                  String  @id @default(cuid())
  studentId           String
  weeklyScheduleId    String
  studentMembershipId String?
  isActive            Boolean @default(true)
  notes               String?

  student           Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weeklySchedule    WeeklyClassSchedule  @relation(fields: [weeklyScheduleId], references: [id], onDelete: Cascade)
  studentMembership StudentMembership?   @relation(fields: [studentMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, weeklyScheduleId])
  @@index([studentId, isActive])
  @@index([weeklyScheduleId])
  @@index([studentMembershipId])
}

model ScheduleChangeRequest {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type   ScheduleChangeRequestType
  status ScheduleChangeRequestStatus @default(PENDING)

  currentScheduleIds   String[]
  requestedScheduleIds String[]

  requestedDate DateTime?
  reason        String
  reviewNotes   String?

  reviewedByUserId String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([type, status])
  @@index([createdAt])
}

model ClassSession {
  id         String             @id @default(cuid())
  scheduleId String?
  coachId    String?
  startsAt   DateTime
  endsAt     DateTime?
  capacity   Int?
  status     ClassSessionStatus @default(SCHEDULED)
  notes      String?

  schedule   WeeklyClassSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  coach      Coach?               @relation(fields: [coachId], references: [id], onDelete: SetNull)
  attendance Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@unique([scheduleId, startsAt])
  @@index([scheduleId])
  @@index([coachId])
  @@index([status])
}

model Attendance {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  checkInAt DateTime?
  notes     String?

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, status])
}
